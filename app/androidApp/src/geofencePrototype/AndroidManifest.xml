<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY, AND ONLY WITH -PgeofencePrototype=true (ruling R2; default off). The opt-in trailhead geofence
  prototype (Spike 4 Task 7) needs background location + boot; androidApp/build.gradle.kts adds this manifest to the
  debug variant only when the property is set. Default debug builds (and every release build) never contain
  ACCESS_BACKGROUND_LOCATION, so Play Protect has nothing to flag and the app hides the opt-in toggle
  (AndroidGeofences.declared is false).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- Geofence transitions from Play services (explicit PendingIntent): not exported. -->
        <receiver
            android:name="com.bainbridgetrails.tracking.GeofenceReceiver"
            android:exported="false" />
        <!-- Re-registers geofences after reboot / app update; acts only on those actions. -->
        <receiver
            android:name="com.bainbridgetrails.tracking.GeofenceBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
