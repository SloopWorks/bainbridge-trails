<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Used only while you record a walk; your route stays on your phone.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Optional: notifies you when you arrive at a trailhead.</string>
	<key>NSMotionUsageDescription</key>
	<string>Keeps bike and car rides from counting as walks.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
</dict>
</plist>
