{
  "name": "bainbridge-trails-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "wrangler types --strict-vars=false",
    "dev": "wrangler d1 migrations apply DB --local && wrangler dev --port 8787 --ip 0.0.0.0",
    "test": "node scripts/build-legal-pages.mjs --check && vitest run",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --strict-vars=false",
    "build:segments": "node scripts/build-segment-meta.mjs",
    "build:segments:roads": "node scripts/build-segment-meta.mjs --dataset roads",
    "build:legal": "node scripts/build-legal-pages.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.151.2"
  },
  "engines": {
    "node": ">=20"
  }
}
