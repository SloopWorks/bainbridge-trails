{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bainbridge-trails-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  // Free tier only: one Worker + one D1 database. No paid features (no Durable Objects, no Queues).
  "workers_dev": true,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bainbridge-trails",
      // Created 2026-10-20 (temp workers.dev deployment; see README "Temporary deployment").
      // Local dev / tests ignore it and use a local SQLite file under .wrangler/.
      "database_id": "bc5e5e39-3f3d-4d81-a998-6b4a6d0d2045",
      "migrations_dir": "migrations"
    }
  ],
  // Non-secret config. OAuth client ids are public identifiers, not secrets.
  // ADMIN_TOKEN is a secret: `npx wrangler secret put ADMIN_TOKEN`.
  // ALLOW_DEV_AUTH must NEVER be set here; it only lives in local .dev.vars.
  "vars": {
    // Comma-separated Google OAuth client ids accepted as `aud` (Android/web client id, iOS client id).
    "GOOGLE_CLIENT_IDS": "",
    // Comma-separated Apple audiences (iOS bundle id, Services ID).
    "APPLE_CLIENT_IDS": "",
    // Apple token revocation on account deletion (TL-10). Leave empty to disable (no-op).
    // Also needs the secret APPLE_PRIVATE_KEY (.p8 contents): `npx wrangler secret put APPLE_PRIVATE_KEY`.
    "APPLE_TEAM_ID": "",
    "APPLE_KEY_ID": "",
    // Shown on GET /delete-account as the email fallback. Same address as docs/legal/*.md.
    // TODO(owner): make sure privacy@sloopworks.com is routed (Cloudflare Email Routing) before publishing.
    "SUPPORT_EMAIL": "privacy@sloopworks.com",
    // Cheat limit (TL-2): new covered metres <= speed x sum(durationS of new walks) + slack.
    "PLAUSIBLE_SPEED_MPS": "4.0",
    "PLAUSIBLE_SLACK_M": "500"
  },
  // TL-11: rebuild leaderboard + community-stats snapshots daily (09:17 UTC = ~1-2 am Pacific). Free tier allows 5 crons.
  "triggers": { "crons": ["17 9 * * *"] }
}
